<!-- https://vpcomm.umich.edu/resources/cookie-disclosure/ -->
<script>
    // redefine the global `define` method to support old 2-parameter invocation
    (function (global) {
        const almondDefine = global.define;

        // Match on a URL fragment so version bumps on the CDN don't break it.
        const scripts = [
            {
                urlFragment: /umich\.edu\/apis\/umconsentmanager/,
                name: "um-consent-manager",
                className: "CookieConsent" // TODO: Figure out the right name
            }
        ];

        function findScript() {
            const src = document.currentScript && document.currentScript.src;
            if (!src) return null;
            for (const script of scripts) {
                if (script.urlFragment.test(src)) return script;
            }
            return null;
        }

        function define(name, deps, factory) {
            if (typeof name !== "string") {
                const script = findScript();
                if (!script) {
                    throw new Error(
                      "Anonymous define() from unmapped script: " +
                      (document.currentScript && document.currentScript.src)
                    );
                }
                const newFactory = deps;
                const newDeps = name;
                const result = almondDefine(script.name, newDeps, newFactory);
                if (script.className) {
                    global[script.className] = global.require(script.name); // sync require runs the factory now
                }
                return result;
            }
            return almondDefine(name, deps, factory);
        }

        define.amd = almondDefine.amd;
        global.define = define;
    })(this);
</script>
<script>
    function initGoogleTagManager(gaId) {
        (function(w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({"gtm.start": new Date().getTime(), event: "gtm.js"});
            var f = d.getElementsByTagName(s)[0];
            var j = d.createElement(s);
            var dl = l != "dataLayer" ? "&l=" + l : "";
            j.async = true;
            j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
            f.parentNode.insertBefore(j, f);
        })(window, document, "script", "dataLayer", gaId)
    }

    window.umConsentManager = {
        customManager: {
            enabled: true,
            // alwaysShow: true
        },
        privacyUrl: "https://lib.umich.edu/about-us/policies/library-privacy-statement",
        onConsentChange: ({ cookie }) => {
            const gaId = "<%= Rails.configuration.google_tag_manager_id || "" %>".trim();
            if (cookie.categories.includes("analytics") && gaId != "") {
                initGoogleTagManager(gaId)
            }
        }
    };
</script>
<script src="https://umich.edu/apis/umconsentmanager/consentmanager.js"></script>
