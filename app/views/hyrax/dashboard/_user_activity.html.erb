<div class="row">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header">
        <%= t('.title') %>
      </div>
      <div class="card-body d-flex justify-content-center">
        <% if Hyrax.config.analytics? %>
          <%= render 'user_activity_graph' %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header">
        <h2 class="card-title text-center"><%= t('.user_summary') %></h2>
      </div>
      <div class="card-body text-center">
        <p><%= t('.registered_users') %>: <%= @presenter.user_count(@start_date.to_date, @end_date.to_date) %></p>
        <p><%= t('.new_visitors') %>: n/a</p>
        <p><%= t('.returning_visitors') %>: n/a</p>
        <p><%= t('.total_visitors') %>: n/a</p>
      </div>
    </div>
  </div>
</div>
